# Agent007 API - Production Environment Variables
# Copy to .env.production and fill in real values

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/agent007_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (optional - for caching)
REDIS_URL=redis://host:6379

# Security (CHANGE THESE!)
JWT_SECRET=your-production-jwt-secret-min-32-chars
ENCRYPTION_MASTER_KEY=your-64-char-hex-encryption-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS (restrict to your domains)
CORS_ORIGIN=https://agentid.xyz,https://www.agentid.xyz

# Blockchain (Base Mainnet)
BLOCKCHAIN_RPC_URL=https://mainnet.base.org
BLOCKCHAIN_PRIVATE_KEY=your-private-key-here
BLOCKCHAIN_CONTRACT_ADDRESS=0x471C4c43672be2d49A2ceC79203c23b7194A22Fa
BLOCKCHAIN_CHAIN=base

# V2 Experimental (keep disabled in production)
# ENABLE_V2_EXPERIMENTAL=false
