# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://agent007:agent007_secret@localhost:5432/agent007_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_MASTER_KEY=your-32-byte-encryption-key-here

# API Keys
API_KEY_PREFIX=agent007_

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Blockchain (Base Mainnet)
BLOCKCHAIN_RPC_URL=https://mainnet.base.org
BLOCKCHAIN_PRIVATE_KEY=your-private-key-here
BLOCKCHAIN_CONTRACT_ADDRESS=0x...
BLOCKCHAIN_CHAIN=base

# V2 Experimental (locked by default)
# ENABLE_V2_EXPERIMENTAL=true
# BLOCKCHAIN_CONTRACT_V2_ADDRESS=0x...

# External Services
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
